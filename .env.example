# Copy to .env and fill in. Never commit .env.

# Google AI Studio API key
LOGGER_GEMINI_KEY=your_gemini_api_key

# Notion integration token and target database
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Comma-separated list of your bank's alert sender addresses
BANK_ALERT_SENDERS=alerts@yourbank.com,alerts@yourotherbank.com

# Gmail OAuth file paths (defaults shown; both are gitignored)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
